# What stays on this PC and never goes to GitHub.
# (Your saved Warcraft Logs login is already outside this folder, in your Windows profile, encrypted.)

# installers and big downloads
*.exe
*.msi
*.zip

# manual backups: git history replaces them (they stay on this PC)
backups/
*.raid-backup.*

# local tool settings
.claude/

# combat logs and other raw data, if any ever land here
*.log
WoWCombatLog*.txt

# the Worker built for the hosted site, with the app baked in (rebuilt from src/ by build.ps1), and the upload tool's files
online/
.wrangler/
node_modules/

# Windows and editor clutter
Thumbs.db
desktop.ini
.vscode/
*.tmp
~$*

notes/Discord pictures/

# (the Debrief in game downloads are served by the site, so every deploy must have them: kept in git)
!site-assets/companion/*.exe
!site-assets/companion/*.zip

# the PC app's build folders (companion/build-dist.ps1 builds it fresh)
companion/app/bin/
companion/app/obj/
