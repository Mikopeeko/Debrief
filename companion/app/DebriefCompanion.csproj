<Project Sdk="Microsoft.NET.Sdk">
  <!-- Debrief Companion: the PC app (its own window, tray icon and the local helper the window talks to).
       Built on .NET Framework 4.8, which every Windows 10 and 11 PC already has, so raiders install nothing extra. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Debrief Companion</AssemblyName>
    <RootNamespace>Debrief</RootNamespace>
    <ApplicationIcon>..\debrief.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Product>Debrief Companion</Product>
    <Company>Debrief</Company>
    <Description>Debrief Companion</Description>
    <Copyright>debriefme.io</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="..\debrief.ico" LogicalName="debrief.ico" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
